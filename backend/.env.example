# Copy this file to `.env` and set values for production.

# Strong random secret used to sign JWT access tokens
CHATAPP_SECRET_KEY=replace-with-a-strong-secret

# Token expiry settings
CHATAPP_ACCESS_TOKEN_EXPIRE_MINUTES=10080
CHATAPP_REFRESH_TOKEN_EXPIRE_DAYS=30

# Database connection
DATABASE_URL=sqlite:///./chatapp.db

# Logging
LOG_LEVEL=INFO
